  "screenshots": [
    {
      "src": "/assets/screenshots/desktop-1.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Monastery360 Desktop View - Map and Monastery Details"
    },
    {
      "src": "/assets/screenshots/mobile-1.png",
      "sizes": "375x667",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Monastery360 Mobile View - Interactive Monastery Explorer"
