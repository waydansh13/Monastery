  "shortcuts": [
    {
      "name": "Explore Monasteries",
      "short_name": "Monasteries",
      "description": "Browse all monasteries on the interactive map",
      "url": "/?view=monasteries",
      "icons": [
        {
          "src": "/assets/icons/icon-96.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Cultural Calendar",
      "short_name": "Calendar",
      "description": "View upcoming festivals and events",
      "url": "/?view=calendar",
      "icons": [
        {
          "src": "/assets/icons/icon-96.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "AI Guide",
      "short_name": "Guide",
      "description": "Chat with the virtual monastery guide",
      "url": "/?view=chatbot",
      "icons": [
        {
          "src": "/assets/icons/icon-96.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "text/plain": [".txt"],
        "application/json": [".json"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+monastery360",
      "url": "/?monastery=%s"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}